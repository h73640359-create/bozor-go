<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : qurilmaga ko'chirish qoidalari (shaxsiy ma'lumotlarni saqlash). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="database"
            path="bozorgo.db" />
        <exclude
            domain="sharedpref"
            path="bozorgo_preferences" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="database"
            path="bozorgo.db" />
        <exclude
            domain="sharedpref"
            path="bozorgo_preferences" />
    </device-transfer>
</data-extraction-rules>
