# ---- Server ----
PORT=3000
# API shu prefiksda ochiladi: http://localhost:3000/api/
API_PREFIX=/api
# Ilova (Android) uchun ruxsat etilgan manbalar (vergul bilan)
CORS_ORIGIN=*

# ---- Ma'lumotlar bazasi (PostgreSQL) ----
DATABASE_URL=postgres://bozorgo:bozorgo@localhost:5432/bozorgo

# ---- Xavfsizlik ----
# Majburiy: JWT imzolash kaliti (kamida 32 belgi, tasodifiy)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_TTL_DAYS=30

# ---- Admin panel (birinchi ishga tushirishda yaratiladi) ----
ADMIN_EMAIL=admin@bozorgo.local
ADMIN_PASSWORD=change-me-admin
ADMIN_NAME=BozorGo Admin

# ---- Tashqi provayderlar ----
# SMS_PROVIDER=none  -> SMS yuborilmaydi, kod faqat demo rejimda qaytariladi
SMS_PROVIDER=none
# PAYMENT_PROVIDER=none -> karta to'lovi amalga oshirilmaydi (demo)
PAYMENT_PROVIDER=none

# ---- Demo rejim ----
# true bo'lsa: OTP kodi javobda qaytariladi (debugCode), to'lov demo deb belgilanadi
DEMO_MODE=true
